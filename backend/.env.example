PORT=3000

# --- Shared Real Mode settings ---
MIMOTO_BASE_URL=https://api.collab.mosip.net/v1/mimoto
SANDBOX_REDIRECT_URI=io.mosip.residentapp.inji://oauthredirect
MOCK_UIN=5860356276
MOCK_OTP=111111
SANDBOX_ACR_VALUES=mosip:idp:acr:generated-code
SANDBOX_TIMEOUT_MS=15000
SANDBOX_TXN_RETRIES=3
STEP_TIMEOUT_MS=30000

# --- Per-format Real Mode issuer config ---
# Every value below has a working default pointing at the public MOSIP Collab sandbox
# (see backend/src/formats/registry.ts) - you only need to set these if you're running
# against your own Certify/eSignet/Mimoto instead of the sandbox, or want to enable Real
# Mode for a format the sandbox doesn't offer (e.g. SD-JWT).
#
# Uncomment and fill in only the ones you want to override. Set REAL_<PREFIX>_ENABLED=false
# to force a format off in Real Mode even though a default exists.

# W3C VC (JSON-LD) - prefix JSONLD
# REAL_JSONLD_ISSUER_ID=Mosip
# REAL_JSONLD_CREDENTIAL_CONFIG_ID=MOSIPVerifiableCredential
# REAL_JSONLD_SCOPE=mosip_identity_vc_ldp
# REAL_JSONLD_KEY_TYPE=EdDSA
# REAL_JSONLD_ESIGNET_HOST=https://esignet-mosipid.collab.mosip.net/v1/esignet
# REAL_JSONLD_ISSUER_HOST=https://injicertify-mosipid.collab.mosip.net
# REAL_JSONLD_CLIENT_ID=mpartner-default-mimoto-mosipid-oidc
# REAL_JSONLD_ENABLED=true

# mDoc / mDL - prefix MDOC
# REAL_MDOC_ISSUER_ID=MockMdl
# REAL_MDOC_CREDENTIAL_CONFIG_ID=DrivingLicenseCredential
# REAL_MDOC_SCOPE=sample_vc_mdoc
# REAL_MDOC_KEY_TYPE=ES256
# REAL_MDOC_ESIGNET_HOST=https://esignet-mock.collab.mosip.net/v1/esignet
# REAL_MDOC_ISSUER_HOST=https://injicertify-mdl.collab.mosip.net
# REAL_MDOC_CLIENT_ID=mpartner-default-mimoto-mdl-oidc
# REAL_MDOC_ENABLED=true

# SD-JWT VC - prefix SDJWT (no sandbox default - stays Simulated-Mode-only until you set
# ALL of these against your own SD-JWT-capable Certify deployment)
# REAL_SDJWT_ISSUER_ID=
# REAL_SDJWT_CREDENTIAL_CONFIG_ID=
# REAL_SDJWT_SCOPE=
# REAL_SDJWT_KEY_TYPE=EdDSA
# REAL_SDJWT_ESIGNET_HOST=
# REAL_SDJWT_ISSUER_HOST=
# REAL_SDJWT_CLIENT_ID=

# --- LLM-assisted failure triage (optional) ---
# When set, a failed Real Mode step gets a Claude-generated explanation of the likely root
# cause (fed the raw error + captured protocol payloads) instead of just a raw error
# string. Leave unset to keep the existing heuristic classifier (classifySandboxError) -
# triage always degrades to that on any failure, so this can never itself break a result.
# ANTHROPIC_API_KEY=
# Defaults to claude-opus-5 if unset. This runs once per failed Real Mode step (not on
# every request), so cost is low, but self-hosters who want to cut it further can switch
# to a cheaper model - e.g. claude-haiku-4-5.
# TRIAGE_MODEL=claude-opus-5

# --- Security ---
# Comma-separated list of allowed frontend origins. Defaults to http://localhost:5173 if unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
